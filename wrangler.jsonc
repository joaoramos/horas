{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "horas",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // O Worker recebe as páginas (para escrever o manifesto certo) e a API.
    // Os ficheiros estáticos são servidos diretamente, sem contar pedidos ao Worker.
    "run_worker_first": ["/*", "!/jm/*", "!/icones/*", "!/app.js", "!/styles.css", "!/sw.js"]
  },
  "routes": [{ "pattern": "horas.jardimdamata.pt", "custom_domain": true }],
  // Todas as noites, às 02:00 UTC (02:00 ou 03:00 em Lisboa), preenche na folha os dias úteis sem registo
  "triggers": { "crons": ["0 2 * * *"] },
  "observability": { "enabled": true }
  // Segredos (wrangler secret put): APPS_SCRIPT_URL, APPS_SCRIPT_TOKEN
}
